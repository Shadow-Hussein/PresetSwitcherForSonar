# Normalise line endings: LF in the repository, native in the working tree.
* text=auto

# Windows-native tooling chokes on LF, so pin these to CRLF on checkout.
*.sln    text eol=crlf
*.csproj text eol=crlf
*.props  text eol=crlf
*.targets text eol=crlf
*.pubxml text eol=crlf
*.manifest text eol=crlf
*.cmd    text eol=crlf
*.bat    text eol=crlf
*.ps1    text eol=crlf

# Source and docs are plain text.
*.cs     text diff=csharp
*.xaml   text
*.json   text
*.yml    text
*.md     text

# Binary assets — never diff or line-ending-mangle these.
*.ico    binary
*.png    binary
*.jpg    binary
*.dll    binary
*.exe    binary
*.pdb    binary

# Keep generated / vendored files out of language statistics and diffs.
*.g.cs           linguist-generated=true
*.g.i.cs         linguist-generated=true
*.designer.cs    linguist-generated=true
